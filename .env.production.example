# TrashAlert Production Environment Configuration
# Copy this file to .env.production and fill in your values
#
# IMPORTANT: Never commit .env.production to version control!

# ============================================================================
# DOMAIN CONFIGURATION
# ============================================================================
# Your production domain name (without https://)
DOMAIN_NAME=trashalert.yourdomain.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: production, staging, or development
ENVIRONMENT=production

# Logging level: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================
# Email for Let's Encrypt certificate notifications
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Let's Encrypt server (production or staging)
# Use staging for testing to avoid rate limits
# Production: https://acme-v02.api.letsencrypt.org/directory
# Staging: https://acme-staging-v02.api.letsencrypt.org/directory
LETSENCRYPT_SERVER=https://acme-v02.api.letsencrypt.org/directory

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Compose project name
COMPOSE_PROJECT_NAME=trashalert

# Docker image tag (for versioning)
IMAGE_TAG=latest

# Development mode: MUST be empty for production
DEV_CODE_MOUNT=

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
# IMPORTANT: Change these values for production!
POSTGRES_DB=trashalert
POSTGRES_USER=trashalert
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_PORT=5432

# ============================================================================
# REDIS CACHE & QUEUE
# ============================================================================
# IMPORTANT: Change this password for production!
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
REDIS_PORT=6379
REDIS_MAXMEMORY=512mb

# ============================================================================
# NGINX CONFIGURATION
# ============================================================================
HTTP_PORT=80
HTTPS_PORT=443

# Worker processes (auto = number of CPU cores)
NGINX_WORKER_PROCESSES=auto

# Worker connections
NGINX_WORKER_CONNECTIONS=1024

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Number of Uvicorn worker processes
# Recommended: (2 x CPU cores) + 1
UVICORN_WORKERS=4

# Maximum request body size (for nginx)
CLIENT_MAX_BODY_SIZE=10M
