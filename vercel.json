{
  "version": 2,
  "builds": [
    {
      "src": "vercel_app/handler.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": "frontend/**,data/addresses_normalized.csv"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)",          "dest": "/vercel_app/handler.py" },
    { "src": "/schedule/(.*)",     "dest": "/vercel_app/handler.py" },
    { "src": "/narpm/print",       "dest": "/vercel_app/handler.py" },
    { "src": "/narpm",             "dest": "/vercel_app/handler.py" },
    { "src": "/houston",           "dest": "/vercel_app/handler.py" },
    { "src": "/phoenix",           "dest": "/vercel_app/handler.py" },
    { "src": "/austin",            "dest": "/vercel_app/handler.py" },
    { "src": "/boston",             "dest": "/vercel_app/handler.py" },
    { "src": "/denver",            "dest": "/vercel_app/handler.py" },
    { "src": "/san_diego",         "status": 301, "headers": { "Location": "/schedule/san-diego" } },
    { "src": "/new_york",          "status": 301, "headers": { "Location": "/schedule/new-york" } },
    { "src": "/los_angeles",       "status": 301, "headers": { "Location": "/schedule/los-angeles" } },
    { "src": "/chicago",           "status": 301, "headers": { "Location": "/schedule/chicago" } },
    { "src": "/seattle",           "status": 301, "headers": { "Location": "/schedule/seattle" } },
    { "src": "/dallas",            "status": 301, "headers": { "Location": "/schedule/dallas" } },
    { "src": "/philadelphia",      "status": 301, "headers": { "Location": "/schedule/philadelphia" } },
    { "src": "/san_antonio",       "status": 301, "headers": { "Location": "/schedule/san-antonio" } },
    { "src": "/charlotte",         "status": 301, "headers": { "Location": "/schedule/charlotte" } },
    { "src": "/columbus",          "status": 301, "headers": { "Location": "/schedule/columbus" } },
    { "src": "/oklahoma_city",     "status": 301, "headers": { "Location": "/schedule/oklahoma-city" } },
    { "src": "/portland",          "status": 301, "headers": { "Location": "/schedule/portland" } },
    { "src": "/minneapolis",       "status": 301, "headers": { "Location": "/schedule/minneapolis" } },
    { "src": "/detroit",           "status": 301, "headers": { "Location": "/schedule/detroit" } },
    { "src": "/atlanta",           "status": 301, "headers": { "Location": "/schedule/atlanta" } },
    { "src": "/miami",             "status": 301, "headers": { "Location": "/schedule/miami" } },
    { "src": "/(.*)",              "dest": "/vercel_app/handler.py" }
  ],
  "installCommand": "pip install -r vercel_app/requirements.txt"
}
