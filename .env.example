# TrashAlert Docker Environment Configuration
# Copy this file to .env for local development
#
# For production deployment, use .env.production.example instead

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: production, staging, or development
ENVIRONMENT=development

# Logging level: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# JWT Token Expiration (in minutes for access token, days for refresh token)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# DATABASE CONFIGURATION
# ============================================================================
# Database URL
# For SQLite (default for local development):
DATABASE_URL=sqlite:///./trashalert.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/trashalert

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Compose project name
COMPOSE_PROJECT_NAME=trashalert
