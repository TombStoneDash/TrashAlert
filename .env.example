# TrashAlert Docker Environment Configuration
# Copy this file to .env for local development
#
# For production deployment, use .env.production.example instead

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: production, staging, or development
ENVIRONMENT=development

# Logging level: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Redis cache TTL (Time To Live) in seconds
# Default: 300 seconds (5 minutes)
REDIS_DEFAULT_TTL=300

# Redis key prefix for namespacing
REDIS_KEY_PREFIX=trashalert:
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# JWT Token Expiration (in minutes for access token, days for refresh token)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# DATABASE CONFIGURATION
# ============================================================================
# Database URL
# For SQLite (default for local development):
DATABASE_URL=sqlite:///./trashalert.db

# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/trashalert

# ============================================================================
# NOTIFICATION SYSTEM CONFIGURATION
# ============================================================================

# Twilio SMS Configuration (REQUIRED for SMS notifications)
# Get your credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567  # Your Twilio phone number in E.164 format

# SendGrid Email Configuration (OPTIONAL for email notifications)
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@trashalert.app  # Email address to send from (must be verified in SendGrid)
# SECURITY CONFIGURATION
# ============================================================================
# CORS allowed origins (comma-separated, no spaces)
# For development, use localhost. For production, use your actual domain(s)
# Example: CORS_ALLOWED_ORIGINS=https://trashalert.com,https://www.trashalert.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Compose project name
COMPOSE_PROJECT_NAME=trashalert

# Docker image tag (for versioning)
IMAGE_TAG=latest

# Development mode: set to ./app to mount code for hot reload
# Leave empty or set to ./empty for production
DEV_CODE_MOUNT=

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
POSTGRES_DB=trashalert
POSTGRES_USER=trashalert
POSTGRES_PASSWORD=trashalert_dev_password
POSTGRES_PORT=5432

# ============================================================================
# REDIS CACHE & QUEUE
# ============================================================================
REDIS_PASSWORD=trashalert_redis_dev_password
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Number of Uvicorn workers (recommended: 2 * CPU cores + 1)
UVICORN_WORKERS=4

# ============================================================================
# NGINX CONFIGURATION
# ============================================================================
HTTP_PORT=80
HTTPS_PORT=443
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024

# ============================================================================
# STRIPE BILLING
# ============================================================================
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs created in Stripe Dashboard
STRIPE_PRICE_PORTFOLIO=price_...
# Base URL for redirect URLs (no trailing slash)
BASE_URL=http://localhost:8000
